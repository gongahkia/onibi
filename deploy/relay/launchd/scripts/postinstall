#!/bin/zsh

emulate -L zsh
setopt errexit nounset pipefail

[[ "$3" == / ]] || exit 1
account='_yeokcham'
group_path="/Groups/$account"
user_path="/Users/$account"
if ! dscl . -read "$group_path" >/dev/null 2>&1; then
    dseditgroup -q -o create -r 'Yeokcham relay service' "$account"
fi
group_id="$(dscl . -read "$group_path" PrimaryGroupID | awk 'NR == 1 { print $2 }')"
[[ "$group_id" == <-> ]] || exit 1
if ! dscl . -read "$user_path" >/dev/null 2>&1; then
    user_id="$(dscl . -list /Users UniqueID | awk '$2 ~ /^[0-9]+$/ && $2 >= 500 { if ($2 > maximum) maximum = $2 } END { print maximum + 1 }')"
    [[ "$user_id" == <-> ]] || exit 1
    dscl . -create "$user_path"
    dscl . -create "$user_path" RealName 'Yeokcham relay service'
    dscl . -create "$user_path" UniqueID "$user_id"
    dscl . -create "$user_path" PrimaryGroupID "$group_id"
    dscl . -create "$user_path" UserShell /usr/bin/false
    dscl . -create "$user_path" NFSHomeDirectory /var/empty
    dscl . -create "$user_path" IsHidden 1
fi
directory='/Library/Application Support/Yeokcham'
example="$directory/relay.conf.example"
config="$directory/relay.conf"
identity="$directory/relay.identity"
install -d -o root -g "$account" -m 0750 "$directory"
[[ -f "$example" ]] || exit 1
if [[ ! -e "$config" ]]; then
    cp "$example" "$config"
fi
[[ -f "$config" && ! -L "$config" ]] || exit 1
chown root:"$account" "$example" "$config"
chmod 0640 "$example" "$config"
if [[ -e "$identity" ]]; then
    [[ -f "$identity" && ! -L "$identity" ]] || exit 1
    chown root:"$account" "$identity"
    chmod 0440 "$identity"
fi
chown root:wheel /usr/local/libexec/yeokcham-relay /Library/LaunchDaemons/com.yeokcham.relay.plist
chmod 0755 /usr/local/libexec/yeokcham-relay
chmod 0644 /Library/LaunchDaemons/com.yeokcham.relay.plist
