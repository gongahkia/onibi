#!/usr/bin/env python3
import argparse
import json
import sys
import urllib.error
import urllib.request


def build_url(pi: str, port: int) -> str:
    if pi.startswith(("http://", "https://")):
        return pi.rstrip("/") + "/ask"
    return f"http://{pi}:{port}/ask"


def request_answer(url: str, payload: dict, timeout: float) -> dict:
    data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def format_heading(path: str, heading_path: list[str]) -> str:
    if not heading_path:
        return path
    return f"{path} :: {' > '.join(heading_path)}"


def print_answer(answer: dict) -> int:
    no_answer = answer.get("no_answer")
    if no_answer:
        print(f"no_answer: {no_answer.get('reason', 'unknown')}")
        return 0

    citations = {citation.get("chunk_id"): citation for citation in answer.get("citations", [])}
    results = answer.get("results", [])
    if not results:
        print("no_answer: no cited chunks")
        return 0

    for index, result in enumerate(results, start=1):
        chunk_id = result.get("chunk_id", "")
        citation = citations.get(chunk_id, result)
        path = citation.get("path", "")
        heading_path = citation.get("heading_path") or []
        start_byte = citation.get("start_byte", 0)
        end_byte = citation.get("end_byte", 0)
        score = result.get("score")
        score_text = f", score={score:.6g}" if isinstance(score, (int, float)) else ""
        print(
            f"[{index}] {format_heading(path, heading_path)} "
            f"(chunk={chunk_id}, bytes={start_byte}..{end_byte}{score_text})"
        )
        content = str(result.get("content", "")).strip()
        if content:
            print(content)
        if index != len(results):
            print()
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="kelp-pi-ask")
    parser.add_argument("query", nargs="+")
    parser.add_argument("--pi", default="pi.local")
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--top-k", type=int, default=None)
    parser.add_argument("--no-answer-threshold", type=float, default=None)
    parser.add_argument("--timeout", type=float, default=10.0)
    parser.add_argument("--json", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    payload = {"q": " ".join(args.query)}
    if args.top_k is not None:
        payload["top_k"] = max(args.top_k, 1)
    if args.no_answer_threshold is not None:
        if args.no_answer_threshold < 0:
            print("--no-answer-threshold must be non-negative", file=sys.stderr)
            return 64
        payload["no_answer_threshold"] = args.no_answer_threshold

    url = build_url(args.pi, args.port)
    try:
        answer = request_answer(url, payload, args.timeout)
        if args.json:
            print(json.dumps(answer, separators=(",", ":"), sort_keys=True))
            return 0
        return print_answer(answer)
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")
        print(f"HTTP {error.code}: {detail}", file=sys.stderr)
        return 69
    except (OSError, json.JSONDecodeError) as error:
        print(f"kelp-pi-ask failed: {error}", file=sys.stderr)
        return 69


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
