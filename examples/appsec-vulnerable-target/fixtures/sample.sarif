{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "kelpclaw-sample-static",
          "rules": [
            {
              "id": "APPSEC_SAMPLE_DEFAULT_ADMIN",
              "name": "Default admin marker exposed",
              "shortDescription": {
                "text": "The sample app exposes a default-admin marker."
              },
              "fullDescription": {
                "text": "The fixture intentionally returns an admin/admin marker on /admin for deterministic harness demos."
              },
              "help": {
                "text": "Remove default credentials and require enrollment before privileged access."
              },
              "properties": {
                "security-severity": "6.8",
                "tags": ["CWE-1392", "A07:2021", "V2.1.1"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "APPSEC_SAMPLE_DEFAULT_ADMIN",
          "level": "warning",
          "message": {
            "text": "Default admin marker is reachable in the sample fixture."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 30
                }
              }
            }
          ],
          "properties": {
            "cwe": ["CWE-1392"],
            "owaspTop10": ["A07:2021"],
            "owaspAsvs": ["V2.1.1"]
          }
        }
      ]
    }
  ]
}
