opam-version: "2.0"
synopsis: "A model-neutral semantic text editor kernel and editing-model API"
description: "The M0/M4 terminal host for a model-neutral programmable modal text editor."
maintainer: "Zenbu contributors"
authors: "Zenbu contributors"
license: "MIT"
homepage: "https://example.invalid/zenbu"
bug-reports: "https://example.invalid/zenbu/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.20"}
  "notty-community" {>= "0.2.4"}
  "uucp" {>= "17.0.0" & < "18.0.0"}
  "uuseg" {>= "17.0.0" & < "18.0.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://example.invalid/zenbu.git"
