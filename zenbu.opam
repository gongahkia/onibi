opam-version: "2.0"
synopsis: "A model-neutral semantic text editor kernel and editing-model API"
description: "The M10 release-hardening terminal host with model-neutral semantic editing, syntax presentation, trusted-local Lua, and isolated Wasmtime Components."
maintainer: "Zenbu contributors"
authors: "Zenbu contributors"
license: "MIT"
homepage: "https://github.com/gongahkia/zenbu"
bug-reports: "https://github.com/gongahkia/zenbu/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.20"}
  "notty-community" {>= "0.2.4"}
  "uucp" {>= "17.0.0" & < "18.0.0"}
  "uuseg" {>= "17.0.0" & < "18.0.0"}
  "tree-sitter" {= "0.1.0"}
  "lsp" {= "1.23.1"}
  "jsonrpc" {= "1.23.1"}
  "yojson" {>= "2.0"}
  "ctypes" {>= "0.24.0"}
  "ctypes-foreign" {>= "0.24.0"}
  "otoml" {>= "1.0.5"}
  "ocamlformat" {= "0.28.1" & with-test}
  "ocaml-lsp-server" {= "1.23.1" & with-test}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://github.com/gongahkia/zenbu.git"
