version = 1
data_dir = "/var/lib/kaypoh"
database_path = "/var/lib/kaypoh/kaypoh.db"

[sources.sportsg-facilities]
enabled = true

[sources.onemap]
enabled = true

# ActiveSG is an imported-session reader. When enabled alongside generic API,
# browser, or public modes, it is the final fallback after those modes fail.
# It remains disabled until the local environment contains a deliberately
# exported Playwright storage state.
[sources.myactivesg]
enabled = false
refresh_minutes = 60

[sources.myactivesg.activesg]
enabled = false
venue_list_url = "https://activesg.gov.sg/facility-bookings/activities/YLONatwvqJfikKOmB5N9U/venues"
scan_all = false
# venue_names = ["Jurong East Sport Hall"]
# session_state_base64 = "env:KAYPOH_ACTIVESG_SESSION_STATE_B64"

# These verified anonymous readers have no API key or login requirement. Their
# windows are deliberately bounded to keep public booking reads modest.
[sources.sba-stadium]
enabled = true
refresh_minutes = 60
availability_max_days = 7

[sources.singapore-badminton-hall]
enabled = true
refresh_minutes = 60
availability_max_days = 7

[sources.smash-arena]
enabled = true
refresh_minutes = 60
availability_max_days = 1

[sources.wyse-active]
enabled = true
refresh_minutes = 60
availability_max_days = 7

# Enable other partners only after adding their approved API contract, browser
# selectors, or public-reader details. Keep all secret values in .env.
[sources.onepa]
enabled = false
refresh_minutes = 30

[sources.onepa.api]
enabled = false
# base_url = "https://partner.example"
# availability_path = "/v1/badminton/availability"
# bearer_token = "env:KAYPOH_ONEPA_API_TOKEN"

[sources.onepa.browser]
enabled = false
# availability_url = "https://partner.example/availability?from={start_date}&to={end_date}"
# login_url = "https://partner.example/login"
# username = "env:KAYPOH_ONEPA_USERNAME"
# password = "env:KAYPOH_ONEPA_PASSWORD"
# username_selector = "input[name=email]"
# password_selector = "input[name=password]"
# submit_selector = "button[type=submit]"
# ready_selector = "[data-availability-ready]"
# slot_json_selector = "script#kaypoh-slots"
# session_state_base64 = "env:KAYPOH_ONEPA_SESSION_STATE_B64"

[sources.onepa.public]
enabled = false
# availability_url = "https://partner.example/availability?from={start_date}&to={end_date}"
# slot_json_selector = "script#kaypoh-slots"

[routing]
provider = "onemap"

[api]
# Containers must listen beyond their own loopback interface. Compose publishes
# this only to the Docker host's loopback interface by default.
address = "0.0.0.0:8373"
allow_remote = true
auth_token = "env:KAYPOH_API_TOKEN"

[mcp]
allow_writes = false

[daemon]
refresh_minutes = 30
