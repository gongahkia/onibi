flowchart LR
  operator["operator\nSSH or direct TTY"]

  subgraph pi["Raspberry Pi 5\nlocal-only runtime"]
    binary["kelp-pi\nsingle Zig binary"]
    chat["chat REPL"]
    architect["triage architect"]
    editor["scanner editor"]
    model["llama.cpp\nlocal GGUF"]
    policy["policy evaluator\npolicies/*.toml"]
    approvals["approval tokens\n/var/lib/kelp-pi/approvals"]
    scope["scope store\n/var/lib/kelp-pi/scope"]
    scanners["scoped scanners\nNuclei/Nmap/ZAP target"]
    evidence["evidence workspace\n/var/lib/kelp-pi/evidence"]
    index["SQLite FTS5 target\n/var/lib/kelp-pi/index"]
    transcript["append-only transcript target\n/var/lib/kelp-pi/sessions"]
    bundle["signed audit bundle target\n/var/lib/kelp-pi/bundles"]
  end

  reviewer["reviewer handoff\nindex.html + manifest + signature"]

  operator --> binary
  binary --> chat
  chat --> architect
  architect --> editor
  model --> architect
  editor --> policy
  policy --> approvals
  policy --> scope
  policy --> scanners
  scanners --> evidence
  evidence --> index
  index --> architect
  chat --> transcript
  transcript --> bundle
  evidence --> bundle
  policy --> bundle
  bundle --> reviewer
