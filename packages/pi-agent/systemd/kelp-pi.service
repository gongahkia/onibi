[Unit]
Description=Kelp Pi Runtime
After=network-online.target
Wants=network-online.target
ConditionPathIsExecutable=/opt/kelp-pi/bin/kelp-pi

[Service]
Type=oneshot
User=kelp-pi
Group=kelp-pi
WorkingDirectory=/var/lib/kelp-pi
ExecStart=/opt/kelp-pi/bin/kelp-pi doctor --data-dir /var/lib/kelp-pi
UMask=0077
StateDirectory=kelp-pi
StateDirectoryMode=0750
ConfigurationDirectory=kelp-pi
ConfigurationDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
KeyringMode=private
RemoveIPC=true
ProtectProc=invisible
ProcSubset=pid
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/kelp-pi
ReadOnlyPaths=/etc/kelp-pi /opt/kelp-pi

[Install]
WantedBy=multi-user.target
