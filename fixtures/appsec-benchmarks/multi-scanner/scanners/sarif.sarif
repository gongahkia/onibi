{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "KelpClaw Benchmark Static",
          "rules": [
            {
              "id": "BENCH_DEFAULT_ADMIN",
              "name": "Default admin marker exposed",
              "fullDescription": {
                "text": "Benchmark fixture exposes a default-admin marker."
              },
              "help": {
                "text": "Remove default credentials and require enrollment before privileged access."
              },
              "properties": {
                "tags": ["CWE-1392", "A07:2021", "V2.1.1"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "BENCH_DEFAULT_ADMIN",
          "level": "warning",
          "message": {
            "text": "Default admin marker is reachable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "context/app.py"
                },
                "region": {
                  "startLine": 30
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
